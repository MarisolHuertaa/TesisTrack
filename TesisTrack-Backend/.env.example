# Copia este archivo como .env y llena tus datos. El archivo .env nunca se sube a GitHub.

# Conexión a MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tesistrack

# Puerto de la API
PORT=5000

# Clave para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria

# Opcional: carpeta donde se guardan los PDF subidos (por defecto TesisTrack-Backend/uploads)
# UPLOAD_DIR=
