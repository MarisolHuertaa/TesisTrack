{
  "name": "tesistrack-backend",
  "version": "1.0.0",
  "description": "API REST de TesisTrack (Express + MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "middlewares/**/*.js",
      "utils/**/*.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
